# ─────────────────────────────────────────────────────────────────────────────
# Alerting Engine — Environment Variables
# Copy to .env.local. NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# Optional: protect the dashboard with a simple password
# (use Next.js middleware for production auth)
DASHBOARD_PASSWORD=

# Base URL for generating links
NEXT_PUBLIC_BASE_URL=http://localhost:3004

# ── Scheduler integration ──────────────────────────────────────────────────
# To run checks on a schedule, use an external cron that calls:
#   POST http://localhost:3004/api/run-check
# Body: {} (runs all enabled rules)
#
# Example crontab (every 15 minutes):
#   */15 * * * * curl -s -X POST http://localhost:3004/api/run-check -H "Content-Type: application/json" -d '{}'
