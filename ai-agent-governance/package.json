{
  "name": "ai-tooling-governance",
  "version": "0.1.0",
  "private": true,
  "main": "electron-dist/electron/main.js",
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start -p 3005",
    "typecheck": "tsc --noEmit",
    "electron:dev": "concurrently -n NEXT,ELECTRON -c cyan,magenta \"npm run dev\" \"wait-on http://localhost:3005 && electron .\"",
    "electron:compile": "tsc --project tsconfig.electron.json",
    "electron:build": "npm run build && npm run electron:compile",
    "electron:dist": "npm run electron:build && electron-builder",
    "electron:dist:mac": "npm run electron:build && electron-builder --mac",
    "electron:dist:win": "npm run electron:build && electron-builder --win",
    "electron:dist:linux": "npm run electron:build && electron-builder --linux"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.55.0",
    "@types/nodemailer": "^8.0.2",
    "better-sqlite3": "^13.0.3",
    "googleapis": "^173.0.0",
    "mammoth": "^1.12.0",
    "next": "14.2.29",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "pdf-parse": "^1.1.1",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.10.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^9.0.8",
    "autoprefixer": "^10.0.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
