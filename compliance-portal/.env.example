# ─────────────────────────────────────────────────────────────────────────────
# Compliance Portal — Environment Variables
# Copy to .env.local and fill in values. NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# Claude API key — required for AI prioritization
ANTHROPIC_API_KEY=sk-ant-...

# Optional: restrict /api/generate-link to callers with this key
# If not set, the endpoint is open (protect with auth middleware in production)
ADMIN_API_KEY=

# Public base URL — used to generate shareable portal links
NEXT_PUBLIC_BASE_URL=http://localhost:3002
