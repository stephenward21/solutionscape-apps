<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Allow JIT compilation (required by Node.js / V8) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory (required by Electron renderer) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Allow dyld environment variables (required by Electron) -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- Disable library validation so native modules (better-sqlite3) load -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Network client access (outbound HTTPS to IdP APIs, AI scan endpoints) -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- File access — user-selected read/write (for scan report export) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
  </dict>
</plist>
