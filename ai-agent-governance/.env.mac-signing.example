# ─── macOS Code Signing & Notarization ───────────────────────────────────────
#
# Copy relevant vars into your shell (or a .env.mac-signing file that you
# source before running `npm run electron:dist:mac`).
#
# None of these should ever be committed to git.
# ─────────────────────────────────────────────────────────────────────────────

# Path to your Developer ID Application .p12 certificate exported from Keychain
# (or set CSC_NAME to the certificate's Common Name and let electron-builder
#  find it in the macOS keychain automatically — easier on a local machine)
CSC_LINK=/path/to/DeveloperIDApplication.p12
CSC_KEY_PASSWORD=your-p12-export-password

# Alternatively — use keychain lookup instead of a .p12 file (local builds only):
# CSC_NAME="Developer ID Application: Your Name (TEAM_ID)"

# 10-character Apple Team ID (visible at developer.apple.com → Membership)
APPLE_TEAM_ID=XXXXXXXXXX

# App Store Connect API key for notarytool (recommended over Apple ID/password)
# Create at appstoreconnect.apple.com → Users → Keys → Add key (Developer role)
APPLE_API_KEY_ID=XXXXXXXXXX
APPLE_API_KEY_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APPLE_API_KEY=/path/to/AuthKey_XXXXXXXXXX.p8

# ─── Optional: Apple ID + app-specific password (legacy notarization path) ──
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx   # generate at appleid.apple.com
